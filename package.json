{
  "name": "satoyama-biyori",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "build:pages": "vite build --base=/inaka/docs/ --outDir=docs",
    "agents:preflight": "node pipeline/agents.mjs --preflight",
    "agents:run": "node pipeline/agents.mjs --browser",
    "agents:gates": "node pipeline/agents.mjs --offline",
    "test:mobile": "node tests/mobile-smoke.mjs",
    "predev": "bash scripts/ensure-autosave.sh",
    "prebuild": "bash scripts/ensure-autosave.sh",
    "prebuild:pages": "bash scripts/ensure-autosave.sh",
    "pretest": "bash scripts/ensure-autosave.sh",
    "autosave:ensure": "bash scripts/ensure-autosave.sh",
    "autosave:status": "bash scripts/autosave-status.sh",
    "autosave:now": "bash scripts/autosave.sh --once",
    "restore": "bash scripts/restore.sh",
    "test:colliders": "npx -y vite-node tests/colliders.mjs && npx -y vite-node tests/colliders-plains.mjs",
    "assets:fetch": "bash scripts/fetch-polyhaven.sh",
    "assets:stats": "node scripts/model-stats.mjs"
  },
  "dependencies": {
    "three": "^0.180.0",
    "lucide": "^0.468.0"
  },
  "devDependencies": {
    "vite": "^6.1.0",
    "@playwright/test": "^1.51.0"
  }
}
